# Process execution UID and GID (must match host user/group owning configs and secrets)
APP_UID=10001
APP_GID=10001

# CrowdSec Local API (LAPI) connection URL
# When connecting to CrowdSec running directly on the host, use http://host.docker.internal:8080/
CS_LAPI_URL=http://host.docker.internal:8080/

# Maximum response body size from CrowdSec LAPI in megabytes (optional, default: 16, min: 16, max: 512).
# Note: If increased above 16MB, ensure mem_limit in docker-compose.yaml is adjusted accordingly.
# MAX_RESPONSE_BODY_MB=16
